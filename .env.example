# Copy this file to .env and fill in your own Supabase project.
# Vite only exposes variables that start with VITE_ to the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-publishable-anon-key

# The map preview on the right. One Google Cloud API key, with two APIs
# enabled on the same project (console.cloud.google.com → APIs & Services →
# Library → Enable):
#
#   Maps JavaScript API   draws the map
#   Geocoding API         turns a typed place into a point to fly the camera to
#
# The key ships inside the bundle, so restrict it in the Cloud console:
# Credentials → the key → Application restrictions: Websites, listing the
# origins you serve from → API restrictions: those two APIs only.
#
# Leave it unset and the app still runs — the pane names the missing variable
# instead of drawing a map.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional. A Map ID does two things: it selects vector rendering, which is
# what lets the camera glide between places rather than step, and it is the
# only way to restyle the map — a `styles` array passed in code is ignored once
# a mapId is set, because Google moved styling to the Cloud console.
#
# This must be the ID from Map Management, NOT the ID of a Map Style. They are
# different objects and a style's ID resolves to nothing here: you get the
# plain default map and, since the fallback is raster, a camera that steps
# instead of glides. Associating a style with the Map ID is its own step, on
# the style's page.
#
# Unset, the app falls back to Google's DEMO_MAP_ID, which works but isn't
# meant for production. Make your own under Google Maps Platform → Map
# Management (map type: JavaScript, rendering: vector), then import
# docs/map-styles/light.json and dark.json as the two variants of one style.
VITE_GOOGLE_MAPS_MAP_ID=

# Normally leave this EMPTY. Light and dark are two variants of a single style,
# so one Map ID covers both themes and the app selects the variant by passing
# colorScheme. Setting this says "my themes live in separate Map IDs", and the
# app stops sending colorScheme — which is the very thing that would have
# chosen the dark variant. Only use it if you genuinely have two styled IDs.
VITE_GOOGLE_MAPS_MAP_ID_DARK=
